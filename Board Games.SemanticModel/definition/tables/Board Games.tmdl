	column 'Rating Average (bins)' =
			IF(
				ISBLANK('Board Games'[Rating Average]),
				BLANK(),
				IF(
					'Board Games'[Rating Average] >= 0,
					ROUNDDOWN('Board Games'[Rating Average], 0),
					ROUNDUP('Board Games'[Rating Average], 0)
				)
			)
		lineageTag: 24a4feae-c9a1-4fb6-9d8c-b28de867cd51
		summarizeBy: none

